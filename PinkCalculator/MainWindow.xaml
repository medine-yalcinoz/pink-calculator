<Window x:Class="PinkCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pink Calculator"
        Height="560"
        Width="320"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FCE4EC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- GENEL BUTON GÖRÜNÜMÜ -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">

            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- RAKAM BUTONLARI -->
        <Style x:Key="NumberButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background" Value="#FFC1E3"/>
            <Setter Property="Foreground" Value="#6A1B4D"/>

        </Style>


        <!-- AC, SİLME, YÜZDE -->
        <Style x:Key="FunctionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background" Value="#F48FB1"/>
            <Setter Property="Foreground" Value="White"/>

        </Style>


        <!-- İŞLEM BUTONLARI -->
        <Style x:Key="OperatorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background" Value="#C2185B"/>
            <Setter Property="Foreground" Value="White"/>

        </Style>

    </Window.Resources>


    <!-- ANA ALAN -->
    <Grid Margin="10">


        <!--
            KONFETİ ALANI

            Butonların ve ekranın üzerinde görünür.
            Tıklamaları engellemez.
        -->
        <Canvas x:Name="ConfettiCanvas"
                Panel.ZIndex="100"
                IsHitTestVisible="False"/>


        <!-- HESAP MAKİNESİ -->
        <Grid>

            <!-- SATIRLAR -->
            <Grid.RowDefinitions>

                <RowDefinition Height="130"/>

                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- SÜTUNLAR -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ==========================================
                 EKRAN
                 ========================================== -->

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Background="#F8BBD0"
                    CornerRadius="18"
                    Margin="4">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- İşlem -->
                        <RowDefinition Height="*"/>

                        <!-- Sonuç -->
                        <RowDefinition Height="2*"/>

                    </Grid.RowDefinitions>


                    <!-- YAPILAN İŞLEM -->

                    <TextBlock x:Name="ExpressionText"
                               Grid.Row="0"
                               Text=""
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#AD1457"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="15,8,15,0"
                               TextTrimming="CharacterEllipsis"/>


                    <!-- SONUÇ -->

                    <ScrollViewer x:Name="DisplayScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalContentAlignment="Right"
                                  VerticalContentAlignment="Center"
                                  Focusable="False">

                        <TextBlock x:Name="DisplayText"
                                   Text="0"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#880E4F"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="15,0"
                                   TextTrimming="CharacterEllipsis"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ==========================================
                 SATIR 1
                 ========================================== -->

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Content="AC"
                    Style="{StaticResource FunctionButtonStyle}"
                    Click="AC_Click"/>


            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="⌫"
                    Style="{StaticResource FunctionButtonStyle}"
                    Click="Backspace_Click"/>


            <Button Grid.Row="1"
                    Grid.Column="2"
                    Content="%"
                    Style="{StaticResource FunctionButtonStyle}"
                    Click="Percent_Click"/>


            <Button Grid.Row="1"
                    Grid.Column="3"
                    Content="÷"
                    Tag="/"
                    Style="{StaticResource OperatorButtonStyle}"
                    Click="Operator_Click"/>


            <!-- ==========================================
                 SATIR 2
                 ========================================== -->

            <Button Grid.Row="2"
                    Grid.Column="0"
                    Content="7"
                    Tag="7"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="8"
                    Tag="8"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="2"
                    Grid.Column="2"
                    Content="9"
                    Tag="9"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="2"
                    Grid.Column="3"
                    Content="×"
                    Tag="*"
                    Style="{StaticResource OperatorButtonStyle}"
                    Click="Operator_Click"/>


            <!-- ==========================================
                 SATIR 3
                 ========================================== -->

            <Button Grid.Row="3"
                    Grid.Column="0"
                    Content="4"
                    Tag="4"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="3"
                    Grid.Column="1"
                    Content="5"
                    Tag="5"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="3"
                    Grid.Column="2"
                    Content="6"
                    Tag="6"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="3"
                    Grid.Column="3"
                    Content="−"
                    Tag="-"
                    Style="{StaticResource OperatorButtonStyle}"
                    Click="Operator_Click"/>


            <!-- ==========================================
                 SATIR 4
                 ========================================== -->

            <Button Grid.Row="4"
                    Grid.Column="0"
                    Content="1"
                    Tag="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="4"
                    Grid.Column="1"
                    Content="2"
                    Tag="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="4"
                    Grid.Column="2"
                    Content="3"
                    Tag="3"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="4"
                    Grid.Column="3"
                    Content="+"
                    Tag="+"
                    Style="{StaticResource OperatorButtonStyle}"
                    Click="Operator_Click"/>


            <!-- ==========================================
                 SATIR 5
                 ========================================== -->

            <Button Grid.Row="5"
                    Grid.Column="0"
                    Content="±"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="PlusMinus_Click"/>


            <Button Grid.Row="5"
                    Grid.Column="1"
                    Content="0"
                    Tag="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Number_Click"/>


            <Button Grid.Row="5"
                    Grid.Column="2"
                    Content="."
                    Style="{StaticResource NumberButtonStyle}"
                    Click="Decimal_Click"/>


            <Button Grid.Row="5"
                    Grid.Column="3"
                    Content="="
                    Style="{StaticResource OperatorButtonStyle}"
                    Click="Equals_Click"/>

        </Grid>

    </Grid>

</Window>